{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Grafana Intelligence Gateway",
  "id": "digitalrcs-intelligencegateway-panel",
  "info": {
    "keywords": ["ai", "llm", "openai", "lmstudio", "intelligence", "assessment", "panel"],
    "description": "Analyze panel query data with local or hosted AI models and display assessments alongside your charts. Connect through the DigitalRCS secure AI data source.",
    "author": {
      "name": "DigitalRCS",
      "url": "https://www.digitalrcs.com"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      { "name": "DigitalRCS", "url": "https://www.digitalrcs.com" },
      { "name": "Source", "url": "https://github.com/DigitalRCS/grafana-intelligence-gateway" },
      { "name": "Documentation", "url": "https://github.com/DigitalRCS/grafana-intelligence-gateway/wiki" },
      { "name": "Issues", "url": "https://github.com/DigitalRCS/grafana-intelligence-gateway/issues" }
    ],
    "screenshots": [
      { "name": "Local AI analysis of synthetic panel data with LM Studio", "path": "img/panel-analysis.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=11.6.0",
    "plugins": [
      {
        "id": "digitalrcs-intelligencegateway-datasource",
        "type": "datasource",
        "name": "Intelligence Gateway Secure AI"
      }
    ]
  }
}
